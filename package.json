{
  "name": "slipbox",
  "private": true,
  "version": "0.1.0",
  "description": "A local, Obsidian-like knowledge graph for the things you learn while working with AI.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch-path=server --watch-path=shared server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "install-skill": "node scripts/install-skill.js",
    "deploy": "scripts/deploy.sh",
    "package-skill": "node scripts/package-skill.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
